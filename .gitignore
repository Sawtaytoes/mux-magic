.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

apps.generated/
apps.downloaded/
build/
dist/
dist-server/
node_modules/
storybook-static/

# Generated by scripts/build-version.cjs at prebuild/prestart; served
# at runtime by src/api/routes/versionRoutes.ts.
public/api/version.json

# Generated by scripts/build-command-descriptions.ts at prebuild/prestart;
# loaded by public/builder/index.html as the field-tooltip content source.
public/builder/js/command-descriptions.js

.cache
.config
.env
installed_packages.txt

# Playwright Test artifacts
playwright-report/
test-results/

# Playwright MCP page snapshots — ephemeral debugging output, never committed
.playwright-mcp/

# Vitest browser-mode failure screenshots
**/__screenshots__/
**/.vitest-attachments/
.vitest-attachments/

# Claude Code per-machine permission overrides
.claude/settings.local.json

# Sub-agent worktrees created by Agent isolation:"worktree" (each is a
# full repo checkout — never meant to be committed to the parent).
.claude/worktrees/

# Per-session runtime lock written by the /schedule + /loop machinery;
# holds a live PID and is replaced on every session start.
.claude/scheduled_tasks.lock

*.log

# ...except the captured MakeMKV robot-mode output committed deliberately
# as test fixtures. Without this negation `*.log` swallows all seven of
# them, and because they still sit on disk locally the analyser tests keep
# passing on a dev machine while CI — which only has what git tracks —
# fails every one of them.
!packages/core/src/tools/makemkv/__fixtures__/*.robot.log

# Local copy of Biome JSON schema (avoids IDE untrusted-URL warning)
biome-schema.downloaded.json

